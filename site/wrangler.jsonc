{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dalibre-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "dalibre.randynamic.org", "custom_domain": true }
  ],
  "workers_dev": false,
  // Branch builds run `wrangler preview`, which needs this block; the
  // site has no bindings for Previews to override.
  "previews": {}
}
